---
const profile = {
  name: 'Dra. Alejandra Ortiz',
  role: 'Abogada',
  whatsapp: '5491137020938',
  whatsappLabel: '+54 9 11 3702-0938',
  email: 'alejandram_ortiz@hotmail.com',
};

const whatsappUrl = `https://wa.me/${profile.whatsapp}?text=${encodeURIComponent('Hola Dra. Ortiz, quisiera realizar una consulta legal.')}`;

const practiceAreas = [
  {
    number: '01',
    title: 'Derecho penal',
    description: 'Te acompaño con una estrategia jurídica responsable en cada instancia del proceso.',
  },
  {
    number: '02',
    title: 'Derecho laboral',
    description: 'Te ofrezco orientación clara para resguardar tus derechos y construir una respuesta jurídica sólida.',
  },
  {
    number: '03',
    title: 'Derecho sindical',
    description: 'Te asesoro en relaciones colectivas de trabajo y representación gremial.',
  },
  {
    number: '04',
    title: 'Servicios empresariales',
    description: 'Acompaño a empresas y emprendimientos con asesoramiento jurídico para sus decisiones cotidianas.',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Dra. Alejandra Ortiz — Asesoramiento jurídico integral." />
    <title>{profile.name} | {profile.role}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#inicio" aria-label="Ir al inicio">Alejandra <span>Ortiz</span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">Abrir menú</span><i></i><i></i>
      </button>
      <nav id="site-nav" aria-label="Principal">
        <a href="#practica">Servicios</a>
        <a href="#perfil">Perfil</a>
        <a class="nav-cta" href="#contacto">Contacto</a>
      </nav>
    </header>

    <main>
      <section class="hero" id="inicio" aria-labelledby="hero-title">
        <div class="hero-content">
          <p class="eyebrow">Asesoramiento jurídico integral</p>
          <h1 id="hero-title">Clara en el criterio.<br /><em>Firme en la defensa.</em></h1>
          <p class="hero-copy">Te acompaño con una mirada cercana y estratégica para que puedas tomar cada decisión con claridad y confianza.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#contacto">Coordinar una consulta <span aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="#practica">Ver servicios <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-footer"><span>Derecho penal · laboral · sindical · empresarial</span><span>Buenos Aires, Argentina</span></div>
      </section>

      <section class="practice section" id="practica" aria-labelledby="practice-title">
        <div class="section-intro">
          <p class="eyebrow">Servicios</p>
          <h2 id="practice-title">Asesoramiento jurídico pensado para cada necesidad.</h2>
        </div>
        <div class="practice-list">
          {practiceAreas.map((area) => (
            <article class="practice-item">
              <span>{area.number}</span>
              <div><h3>{area.title}</h3><p>{area.description}</p></div>
              <span class="arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="profile section" id="perfil" aria-labelledby="profile-title">
        <div class="profile-content">
          <p class="eyebrow">Perfil profesional</p>
          <h2 id="profile-title">El derecho requiere escucha, precisión y presencia.</h2>
          <p>Trabajo con una perspectiva integral: primero escucho tu situación, luego analizo las alternativas y te acompaño durante todo el proceso.</p>
          <p>Me dedico a asuntos de derecho penal, laboral y sindical, para transformar cuestiones complejas en alternativas claras y fundadas.</p>
          <a class="button button-outline" href="#contacto">Contacto <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="contact" id="contacto" aria-labelledby="contact-title">
        <p class="eyebrow">Primer paso</p>
        <h2 id="contact-title">Hablemos de tu consulta.</h2>
        <p>Elegí el medio que te resulte más cómodo para contarme tu situación y coordinar una primera conversación.</p>
        <div class="contact-options">
          <a class="contact-option" href={`mailto:${profile.email}`}><svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M3.5 6.5h17v11h-17zM3.7 6.7 12 13l8.3-6.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Mail</span><strong>{profile.email}</strong><b aria-hidden="true">↗</b></a>
          <a class="contact-option" href={whatsappUrl} target="_blank" rel="noreferrer"><svg aria-hidden="true" viewBox="0 0 32 32" fill="currentColor"><path d="M27.4 4.55A15.85 15.85 0 0 0 16.1 0C7.36 0 .24 7.1.24 15.85c0 2.8.73 5.53 2.11 7.93L.1 32l8.4-2.2a15.86 15.86 0 0 0 7.58 1.93h.01c8.74 0 15.85-7.1 15.85-15.86 0-4.23-1.65-8.2-4.54-11.32ZM16.1 29.06a13.2 13.2 0 0 1-6.74-1.85l-.48-.29-4.99 1.31 1.33-4.86-.31-.5a13.13 13.13 0 0 1-2.03-7.01c0-7.29 5.93-13.22 13.23-13.22 3.53 0 6.84 1.38 9.34 3.88a13.12 13.12 0 0 1 3.87 9.35c0 7.29-5.93 13.2-13.22 13.2Zm7.25-9.9c-.4-.2-2.35-1.16-2.72-1.3-.36-.13-.63-.2-.9.2-.26.39-1.02 1.3-1.24 1.57-.23.26-.46.3-.86.1-.4-.2-1.68-.62-3.2-1.99a12 12 0 0 1-2.21-2.75c-.23-.4-.03-.62.17-.81.18-.18.4-.46.6-.7.2-.22.26-.4.4-.66.13-.27.06-.5-.03-.7-.1-.2-.9-2.16-1.23-2.96-.32-.77-.65-.67-.9-.68l-.76-.01c-.26 0-.7.1-1.05.5-.36.4-1.38 1.35-1.38 3.3 0 1.95 1.42 3.83 1.62 4.1.2.27 2.79 4.26 6.75 5.98.94.4 1.67.65 2.25.83.95.3 1.81.26 2.49.16.76-.12 2.35-.96 2.68-1.9.33-.93.33-1.73.23-1.9-.1-.16-.36-.26-.76-.46Z"/></svg><span>WhatsApp</span><strong>{profile.whatsappLabel}</strong><b aria-hidden="true">↗</b></a>
        </div>
      </section>
    </main>

    <footer><a class="brand" href="#inicio">Alejandra <span>Ortiz</span></a><p>© {new Date().getFullYear()} {profile.name}</p><a href={whatsappUrl} target="_blank" rel="noreferrer">{profile.whatsappLabel}</a></footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('is-open');
      }));
    </script>
  </body>
</html>

<style>
  :root { --ink:#132129; --paper:#f4f0e8; --gold:#b6965c; --muted:#687477; --line:rgba(19,33,41,.17); }
  * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; color:var(--ink); background:var(--paper); font-family:'DM Sans',sans-serif; font-size:16px; line-height:1.65; } a { color:inherit; text-decoration:none; } h1,h2,h3,p { margin:0; } h1,h2,h3 { font-family:'Playfair Display',serif; line-height:1.08; font-weight:600; } .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .site-header { position:absolute; z-index:2; top:0; left:0; width:100%; padding:25px max(5vw,32px); display:flex; align-items:center; justify-content:space-between; color:#fff; } .brand { font-family:'Playfair Display',serif; font-size:23px; font-weight:700; letter-spacing:-.055em; white-space:nowrap; } .brand span { color:var(--gold); } nav { display:flex; gap:31px; align-items:center; font-size:13px; font-weight:500; } nav > a:not(.nav-cta) { opacity:.85; transition:opacity .2s; } nav > a:not(.nav-cta):hover { opacity:1; } .nav-cta { border:1px solid var(--gold); border-radius:999px; background:var(--gold); color:var(--ink); padding:10px 18px; transition:background .2s,color .2s,transform .2s; } .nav-cta:hover { background:#fff; border-color:#fff; transform:translateY(-1px); }
  .menu-toggle { display:none; background:transparent; border:0; padding:6px 0; width:30px; } .menu-toggle i { display:block; height:1px; background:#fff; margin:6px 0; }
  .hero { min-height:720px; min-height:100svh; color:#fff; padding:118px max(5vw,32px) 40px; display:flex; flex-direction:column; justify-content:flex-start; position:relative; background:linear-gradient(90deg,rgba(8,18,22,.84) 0%,rgba(8,18,22,.6) 47%,rgba(8,18,22,.25) 100%),url('/images/ale_fondo.jpg') center/cover; } .hero-content { max-width:750px; } .eyebrow { color:var(--gold); letter-spacing:.11em; text-transform:uppercase; font-size:13px; font-weight:600; margin-bottom:20px; } h1 { font-size:clamp(2.7rem,5.7vw,5.5rem); letter-spacing:-.055em; } h1 em { font-weight:500; } .hero-copy { font-size:17px; max-width:510px; margin-top:26px; color:rgba(255,255,255,.82); } .hero-actions { margin-top:34px; display:flex; gap:15px; align-items:center; flex-wrap:wrap; } .button { display:inline-flex; align-items:center; justify-content:center; gap:13px; border-radius:999px; text-transform:uppercase; letter-spacing:.08em; font-size:12px; font-weight:600; padding:16px 22px; transition:transform .2s,background .2s,border-color .2s; } .button span:last-child { margin-left:7px; font-size:16px; line-height:1; } .button:hover { transform:translateY(-2px); } .button-primary { background:var(--gold); color:#18232a; box-shadow:0 10px 28px rgba(0,0,0,.2); } .button-primary:hover { background:#d0b477; } .button-secondary { color:#fff; border:1px solid rgba(255,255,255,.72); background:rgba(19,33,41,.2); } .button-secondary:hover { background:#fff; color:var(--ink); border-color:#fff; } .button-outline { margin-top:32px; border:1px solid var(--ink); color:var(--ink); } .button-outline:hover { background:var(--ink); color:var(--paper); } .hero-footer { position:absolute; left:max(5vw,32px); right:max(5vw,32px); bottom:34px; display:flex; justify-content:space-between; padding-top:17px; border-top:1px solid rgba(255,255,255,.3); font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:rgba(255,255,255,.8); }
  .section { padding:clamp(62px,8vw,108px) max(8vw,32px); } .profile { max-width:760px; margin:auto; text-align:center; } .profile-content { max-width:650px; margin:auto; } h2 { font-size:clamp(2.25rem,4.2vw,4.1rem); letter-spacing:-.05em; } .profile-content p:not(.eyebrow) { margin-top:23px; color:#465154; max-width:590px; margin-left:auto; margin-right:auto; }
  .practice { background:var(--ink); color:#f9f6ef; } .section-intro { display:grid; grid-template-columns:1fr 1.4fr; max-width:1220px; margin:0 auto 52px; } .section-intro h2 { max-width:720px; } .practice-list { max-width:1220px; margin:auto; border-top:1px solid rgba(255,255,255,.2); } .practice-item { display:grid; grid-template-columns:12% 1fr auto; gap:22px; padding:27px 0 25px; border-bottom:1px solid rgba(255,255,255,.2); } .practice-item > span:first-child { color:var(--gold); font-size:12px; } .practice-item h3 { font-size:clamp(1.7rem,2.8vw,2.55rem); letter-spacing:-.04em; } .practice-item p { color:rgba(255,255,255,.67); font-size:15px; max-width:500px; margin-top:8px; } .practice-item .arrow { color:var(--gold); font-size:23px; }
  .approach { max-width:1440px; margin:auto; display:grid; grid-template-columns:.55fr 1.3fr 1fr; gap:45px; } .approach-number { color:var(--gold); font-size:12px; letter-spacing:.1em; } .principles { border-left:1px solid var(--line); padding-left:35px; } .principles p { font-size:15px; color:#566164; margin-bottom:20px; } .principles strong { display:block; color:var(--ink); font-size:16px; font-weight:600; margin-bottom:2px; }
  .contact { text-align:center; color:#fff; background:#1d3039; padding:clamp(68px,8vw,108px) 24px; } .contact .eyebrow { margin-bottom:19px; } .contact h2 { font-size:clamp(3rem,6vw,5.4rem); } .contact p:not(.eyebrow) { color:rgba(255,255,255,.75); max-width:560px; margin:25px auto 34px; } .contact-options { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; max-width:700px; margin:auto; text-align:left; } .contact-option { position:relative; min-height:120px; padding:24px 52px 22px 66px; border:1px solid rgba(255,255,255,.45); border-radius:26px; background:rgba(255,255,255,.04); transition:background .2s,transform .2s,border-color .2s; } .contact-option:hover { background:rgba(255,255,255,.12); border-color:var(--gold); transform:translateY(-2px); } .contact-option svg { position:absolute; left:23px; top:29px; width:25px; height:25px; color:var(--gold); } .contact-option span { display:block; color:var(--gold); text-transform:uppercase; letter-spacing:.1em; font-size:12px; font-weight:600; margin-bottom:8px; } .contact-option strong { display:block; font-size:15px; font-weight:500; overflow-wrap:anywhere; } .contact-option b { position:absolute; right:22px; top:50%; transform:translateY(-50%); color:var(--gold); font-size:20px; font-weight:400; }
  footer { display:flex; align-items:center; justify-content:space-between; padding:25px max(5vw,32px); background:#132129; color:rgba(255,255,255,.7); font-size:11px; } footer .brand { color:#fff; } footer a:last-child { color:var(--gold); }
  :focus-visible { outline:2px solid var(--gold); outline-offset:4px; }
  @media (max-width:760px) { body { font-size:17px; line-height:1.68; } .site-header { padding:21px 24px; } .menu-toggle { display:block; z-index:4; } nav { display:none; position:absolute; top:0; left:0; right:0; padding:83px 24px 28px; background:#132129; flex-direction:column; align-items:flex-start; gap:19px; } nav.is-open { display:flex; } .nav-cta { margin-top:5px; } .hero { min-height:700px; padding:105px 24px 92px; background-position:57% center; } .eyebrow { font-size:14px; } .hero-copy { font-size:18px; } .hero-footer { left:24px; right:24px; bottom:22px; gap:10px; font-size:12px; letter-spacing:.06em; } .profile { padding-left:24px; padding-right:24px; } .section-intro { display:block; margin-bottom:38px; } .practice { padding-left:24px; padding-right:24px; } .practice-item { grid-template-columns:35px 1fr 20px; gap:12px; } .practice-item p { font-size:16px; } .contact-options { grid-template-columns:1fr; } .contact-option span { font-size:12px; } .contact-option strong { font-size:16px; } footer { padding:22px 24px; flex-wrap:wrap; gap:10px 20px; } }
</style>
